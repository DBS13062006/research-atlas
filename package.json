{
  "name": "research-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts up",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts reset",
    "db:test": "tsx --env-file-if-exists=.env.local scripts/db/test.ts",
    "db:seed:fixture": "tsx --env-file-if-exists=.env.local scripts/db/seed-fixture.ts",
    "queries:run": "tsx --env-file-if-exists=.env.local scripts/queries/run.ts",
    "graph:schema": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/schema.ts",
    "graph:sync": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/sync.ts",
    "graph:rebuild": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/rebuild.ts",
    "graph:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/check.ts",
    "graph:analytics": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/analytics.ts",
    "graph:export-native": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/export-native.ts",
    "cypher:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/graph/cypher-run.ts",
    "data:all": "tsx scripts/data/all.ts",
    "embed:papers": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/embed/papers.ts",
    "layout:umap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/layout/umap.ts",
    "seed:demo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/data/seed-demo.ts",
    "demo:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/data/demo-reset.ts",
    "docs:schema": "tsx --env-file-if-exists=.env.local scripts/docs/schema.ts",
    "docs:screenshots": "SCREENSHOTS=1 playwright test tests/e2e/pages.spec.ts",
    "verify:all": "tsx scripts/verify/all.ts",
    "db:down": "docker compose --env-file .env.local stop",
    "db:rollback-all": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts down-all",
    "docs:er": "tsx scripts/er/generate-drawio.ts && /Applications/draw.io.app/Contents/MacOS/draw.io -x -f png --scale 0.6 -b 20 -o docs/er/research-atlas-er.png docs/er/research-atlas-er.drawio && /Applications/draw.io.app/Contents/MacOS/draw.io -x -f svg -b 20 -o docs/er/research-atlas-er.svg docs/er/research-atlas-er.drawio",
    "docs:ddl": "tsx --env-file-if-exists=.env.local scripts/psql-snapshots.ts",
    "ingest:topics": "tsx --env-file-if-exists=.env.local scripts/ingest/topics.ts",
    "ingest:works": "tsx --env-file-if-exists=.env.local scripts/ingest/works.ts",
    "ingest:expand": "tsx --env-file-if-exists=.env.local scripts/ingest/expand.ts",
    "ingest:load": "tsx --env-file-if-exists=.env.local scripts/ingest/load.ts",
    "ingest:methods": "tsx --env-file-if-exists=.env.local scripts/ingest/methods.ts",
    "ingest:retractions": "tsx --env-file-if-exists=.env.local scripts/ingest/retractions.ts",
    "data:fixture": "tsx --env-file-if-exists=.env.local scripts/data/export-fixture.ts",
    "data:report": "tsx --env-file-if-exists=.env.local scripts/data/report.ts",
    "perf:lighthouse": "node scripts/perf/lighthouse.mts",
    "setup:fixture": "tsx scripts/setup/fixture.ts",
    "docs:catalog": "tsx --env-file-if-exists=.env.local scripts/docs/catalog.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@huggingface/transformers": "4.3.1",
    "@node-rs/argon2": "2.2.2",
    "@scalar/nextjs-api-reference": "0.12.12",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "d3": "7.9.0",
    "lucide-react": "1.61.0",
    "neo4j-driver": "6.2.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "umap-js": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3": "7.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "dbmate": "2.37.0",
    "lighthouse": "13.5.0",
    "mermaid": "12.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22"
  }
}
