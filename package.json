{
  "name": "research-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts up",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts reset",
    "db:test": "node scripts/stub.mjs db:test",
    "db:seed:fixture": "node scripts/stub.mjs db:seed:fixture",
    "queries:run": "node scripts/stub.mjs queries:run",
    "graph:schema": "node scripts/stub.mjs graph:schema",
    "graph:sync": "node scripts/stub.mjs graph:sync",
    "graph:rebuild": "node scripts/stub.mjs graph:rebuild",
    "graph:check": "node scripts/stub.mjs graph:check",
    "graph:analytics": "node scripts/stub.mjs graph:analytics",
    "graph:export-native": "node scripts/stub.mjs graph:export-native",
    "cypher:run": "node scripts/stub.mjs cypher:run",
    "data:all": "node scripts/stub.mjs data:all",
    "embed:papers": "node scripts/stub.mjs embed:papers",
    "layout:umap": "node scripts/stub.mjs layout:umap",
    "seed:demo": "node scripts/stub.mjs seed:demo",
    "demo:reset": "node scripts/stub.mjs demo:reset",
    "docs:schema": "node scripts/stub.mjs docs:schema",
    "docs:screenshots": "node scripts/stub.mjs docs:screenshots",
    "verify:all": "node scripts/stub.mjs verify:all",
    "db:down": "docker compose --env-file .env.local stop",
    "db:rollback-all": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts down-all"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "2.2.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "neo4j-driver": "6.2.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22"
  }
}
