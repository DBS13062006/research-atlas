# Copy to .env.local and fill in the empty values. Never commit .env.local.

# --- secrets ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
NEO4J_PASSWORD=
OPENALEX_API_KEY=
OPENALEX_MAILTO=you@example.com
SEED_PASSWORD=

# --- connection settings ---
POSTGRES_DB=researchatlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: when unset, both URLs are composed from the values above.
# DATABASE_URL=postgres://ra_app:<APP_DB_PASSWORD>@localhost:5432/researchatlas
# DATABASE_OWNER_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/researchatlas
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
OLLAMA_URL=http://localhost:11434
EMBEDDINGS_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
SESSION_COOKIE_SECURE=false
